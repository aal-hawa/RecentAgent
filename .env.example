# Copy this file to `.env` and fill in your values (optional —
# you can also configure everything from the app's sidebar).

# Provider: groq | openai | ollama
RECENT_PROVIDER=ollama

# API key (not needed for Ollama)
# Get a free Groq key at: https://console.groq.com
RECENT_API_KEY=

# Optional overrides (defaults are picked automatically)
# RECENT_MODEL=llama3.1
