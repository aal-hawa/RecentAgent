# Copy this file to `.env` and fill in your values (optional —
# you can also configure everything from the app's sidebar).

# Provider: google | groq | openai | ollama
RECENT_PROVIDER=ollama

# API key (not needed for Ollama)
# Google (recommended, free trial): https://aistudio.google.com
# The app also reads GEMINI_API from your environment automatically.
# Groq (free): https://console.groq.com
RECENT_API_KEY=

# Optional overrides (defaults are picked automatically)
# For google use: gemini-flash-latest (always points at the newest Flash)
# RECENT_MODEL=llama3.1
