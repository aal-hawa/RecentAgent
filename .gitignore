# ============================================================================
# RecentAgent — everything below is generated at runtime or machine-specific.
# The GitHub repo should contain ONLY source code, docs and sample data.
# ============================================================================

# --- Python runtime ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- Runtime artifacts created by RecentAgent itself ---
# Indexed knowledge base (chunks.json + vectors.npz) lives in data/kb/
data/
# Uploaded / generated documents
uploads/
*.log
# Local helper flags / transfer temp files (never commit these)
.nobrowser
*.b64

# --- Secrets & configuration ---
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# --- Node.js (only needed if you add JS tooling / a web frontend later) ---
node_modules/
.next/
out/
dist/
build/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
bun.lockb

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-*
